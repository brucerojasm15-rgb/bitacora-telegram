# --- Desarrollo local ---
# Usa la URL PÚBLICA de Postgres (Railway → servicio Postgres → Connect → Public Network)
# porque tu máquina no tiene acceso a la red privada de Railway.
#
# --- Producción (Railway) ---
# En el servicio pendientes-web dentro de Railway, esta variable debe apuntar a la
# URL INTERNA (postgres.railway.internal), usando una referencia a la variable del
# servicio Postgres en vez de pegar el valor a mano: ${{Postgres.DATABASE_URL}}
# (Railway resuelve esto automáticamente en la pestaña Variables del servicio).
DATABASE_URL=postgresql://usuario:password@host.proxy.rlwy.net:puerto/railway

# Clave simple para proteger el acceso (ver server.js). Genera una propia con:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ACCESS_KEY=cambia-esta-clave

# Opcional en local (por defecto 3000). NO la definas en Railway: Railway asigna
# su propio PORT automáticamente y server.js ya lo respeta (process.env.PORT).
PORT=3000

# Claves VAPID para Web Push. Genera tu propio par con:
#   npx web-push generate-vapid-keys
# La pública se expone al navegador (no es secreta); la privada NO debe compartirse.
VAPID_PUBLIC_KEY=cambia-esta-clave-publica
VAPID_PRIVATE_KEY=cambia-esta-clave-privada

# Hora (America/Lima) a la que corre el chequeo diario de "hechos".
# Formato HH:MM, 24 horas. Si no está definida, usa 20:00 por defecto.
HORA_NOTIFICACION=20:00

# Secreto para firmar la cookie de sesión (login real, Paso 3). Genera el tuyo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ACCESS_KEY queda desactivada pero no borrada (ver comentario en server.js).
SESSION_SECRET=cambia-este-secreto
# ACCESS_KEY=cambia-esta-clave

# --- Google Calendar (rama-google-calendar, tarea 10 del roadmap) ---
# ESQUELETO SIN PROBAR todavía — hasta que estas 3 no tengan valores reales,
# /calendario/* responde 500 "no configurada" en vez de fallar feo.
# Registrá la app en https://console.cloud.google.com/apis/credentials
# (tipo "Aplicación web"), habilitá la Google Calendar API, y agregá
# GOOGLE_REDIRECT_URI (local y producción, una por entorno) como "URI de
# redireccionamiento autorizado" en esa pantalla.
GOOGLE_CLIENT_ID=cambia-este-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=cambia-este-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/calendario/callback

# Clave separada de SESSION_SECRET para cifrar (AES-256-GCM) el access/
# refresh token de Google antes de guardarlos en la tabla
# google_calendar_tokens — 32 bytes en hex. Generá la tuya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=cambia-esta-clave-de-32-bytes-en-hex

# --- Segmentación de ideas con IA (rama-segmentacion-ideas, Fase 1 de v0.2) ---
# Groq (nivel gratis, sin tarjeta, Llama 3.3 70B) — mismo proveedor que
# rama-ia-companera-fase2 (tarea 9), reimplementado acá porque esa rama
# todavía no está en main (ver COORDINACION.md). Sin esta clave,
# segmentarIdeaConGroq cae a su fallback (guarda la idea sin partir, sin
# etiqueta) en vez de fallar feo. Conseguí la tuya (gratis) en
# https://console.groq.com/keys
GROQ_API_KEY=cambia-esta-clave
