<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { titulo: 'Amigos' }) %>
</head>
<body>
  <main>
<%- include('partials/nav') %>
    <h1><%- include('partials/icono', { nombre: 'personas' }) %> Amigos</h1>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } else { %>
      <!-- rama-racha (Fase 3 de v0.2): racha DIARIA, distinta del contador
           semanal de /estadisticas -- no lo reemplaza, es otro dato. -->
      <p class="racha-propia">
        <%- include('partials/icono', { nombre: 'llama' }) %>
        <% if (miRacha > 0) { %>
          Llevás <strong><%= miRacha %></strong> día<%= miRacha === 1 ? '' : 's' %> seguido<%= miRacha === 1 ? '' : 's' %> completando algo.
        <% } else { %>
          Todavía no armaste una racha — completar algo hoy es un buen comienzo.
        <% } %>
      </p>

      <form method="POST" action="/amigos/solicitar" class="nuevo">
        <input type="text" name="nombre_usuario" placeholder="Nombre de usuario..." autocapitalize="none" autocorrect="off" spellcheck="false" required>
        <button type="submit">Agregar</button>
      </form>

      <% if (codigoInvitacion) { %>
        <div class="invitar-amigo">
          <label for="enlace-invitacion">O invitá con un enlace — se pre-carga la solicitud al registrarse:</label>
          <div class="invitar-amigo-fila">
            <input type="text" id="enlace-invitacion" readonly value="/registro?invitacion=<%= codigoInvitacion %>" data-codigo="<%= codigoInvitacion %>">
            <button type="button" id="copiar-invitacion"><%- include('partials/icono', { nombre: 'portapapeles' }) %> Copiar</button>
          </div>
        </div>
      <% } %>

      <h2>Solicitudes recibidas</h2>
      <% if (recibidas.length === 0) { %>
        <p class="empty">No tienes solicitudes pendientes.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Usuario</th>
              <th>Fecha</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% recibidas.forEach((s) => { %>
              <tr>
                <td><%= s.nombre_usuario %></td>
                <td><%= new Date(s.fecha).toLocaleString('es-PE', { timeZone: 'America/Lima' }) %></td>
                <td>
                  <div class="acciones">
                    <form method="POST" action="/amigos/<%= s.amistad_id %>/aceptar">
                      <button type="submit"><%- include('partials/icono', { nombre: 'check' }) %> Aceptar</button>
                    </form>
                    <form method="POST" action="/amigos/<%= s.amistad_id %>/rechazar">
                      <button type="submit"><%- include('partials/icono', { nombre: 'x' }) %> Rechazar</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

      <h2>Solicitudes enviadas</h2>
      <% if (enviadas.length === 0) { %>
        <p class="empty">No tienes solicitudes enviadas pendientes.</p>
      <% } else { %>
        <ul class="chat-mensajes">
          <% enviadas.forEach((s) => { %>
            <li>
              <span class="autor"><%= s.nombre_usuario %></span>
              <span class="texto">Pendiente de respuesta</span>
              <span class="fecha"><%= new Date(s.fecha).toLocaleString('es-PE', { timeZone: 'America/Lima' }) %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <h2>Mis amigos</h2>
      <% if (amigos.length === 0) { %>
        <p class="empty">Todavía no tienes amigos agregados.</p>
      <% } else { %>
        <ul class="chat-mensajes">
          <% amigos.forEach((a) => { %>
            <li>
              <span class="autor"><%= a.nombre_usuario %></span>
              <span class="racha-amigo" title="Racha diaria">
                <%- include('partials/icono', { nombre: 'llama' }) %> <%= a.racha %>
              </span>
              <a href="/chat?amistad_id=<%= a.amistad_id %>" class="btn-link"><%- include('partials/icono', { nombre: 'chat' }) %> Chat</a>
              <a href="/trazabilidad?amistad_id=<%= a.amistad_id %>" class="btn-link"><%- include('partials/icono', { nombre: 'grafico' }) %> Actividad</a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    <% } %>
  </main>

  <% if (codigoInvitacion) { %>
    <script>
      (function () {
        var input = document.getElementById('enlace-invitacion');
        var boton = document.getElementById('copiar-invitacion');
        if (!input || !boton) return;
        input.value = location.origin + '/registro?invitacion=' + input.dataset.codigo;
        boton.addEventListener('click', function () {
          navigator.clipboard.writeText(input.value).then(function () {
            var textoOriginal = boton.textContent;
            boton.textContent = 'Copiado';
            setTimeout(function () { boton.textContent = textoOriginal; }, 1500);
          }).catch(function () {
            input.select();
          });
        });
      })();
    </script>
  <% } %>

<%- include('partials/scripts') %>
</body>
</html>
