<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { titulo: 'Captura rápida' }) %>
</head>
<body>
  <main>
<%- include('partials/nav') %>
    <h1>⚡ Captura rápida</h1>
    <p class="count">Escribe lo que sea y elige qué es antes de guardarlo.</p>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <% if (typeof guardado !== 'undefined' && guardado) { %>
      <p class="notificacion">Guardado.</p>
    <% } %>

    <form method="POST" action="/captura" id="form-captura" class="captura-form">
      <textarea name="texto" id="captura-texto" rows="3" placeholder="Escribe aquí..." required></textarea>

      <div class="captura-tipos" role="group" aria-label="Tipo">
        <button type="submit" name="tipo" value="pendiente" class="captura-tipo-btn">✅ Pendiente</button>
        <button type="submit" name="tipo" value="idea" class="captura-tipo-btn">💡 Idea</button>
        <button type="submit" name="tipo" value="recordatorio" class="captura-tipo-btn" id="btn-recordatorio">⏰ Recordatorio</button>
      </div>

      <div id="campo-cuando" class="captura-cuando" hidden>
        <label for="captura-cuando">¿Cuándo?</label>
        <input type="datetime-local" name="cuando" id="captura-cuando">
      </div>
    </form>
  </main>

  <script>
    // El campo de fecha/hora solo se pide cuando el tipo elegido es
    // "Recordatorio" — para los otros dos tipos se envía sin tocarlo (queda
    // vacío y el backend lo ignora porque tipo !== 'recordatorio').
    const botonRecordatorio = document.getElementById('btn-recordatorio');
    const campoCuando = document.getElementById('campo-cuando');
    const inputCuando = document.getElementById('captura-cuando');
    const form = document.getElementById('form-captura');

    botonRecordatorio.addEventListener('click', (e) => {
      if (campoCuando.hidden) {
        e.preventDefault();
        campoCuando.hidden = false;
        inputCuando.focus();
      }
    });

    form.addEventListener('submit', (e) => {
      const tipoElegido = document.activeElement && document.activeElement.name === 'tipo'
        ? document.activeElement.value
        : null;
      if (tipoElegido === 'recordatorio' && !inputCuando.value) {
        e.preventDefault();
        campoCuando.hidden = false;
        inputCuando.focus();
      }
    });
  </script>
<%- include('partials/scripts') %>
</body>
</html>
