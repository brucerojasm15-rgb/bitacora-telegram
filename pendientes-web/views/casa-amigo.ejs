<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { titulo: nombreAmigo ? ('Casa de ' + nombreAmigo) : 'Casa de un amigo' }) %>
</head>
<body>
  <main>
<%- include('partials/nav') %>
    <h1><%- include('partials/icono', { nombre: 'pata' }) %> Casa de <%= nombreAmigo || 'un amigo' %></h1>
    <a class="btn-link" href="/amigos"><%- include('partials/icono', { nombre: 'flecha-izq' }) %> Volver a amigos</a>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } else if (animales.length === 0) { %>
      <p class="empty">Todavía no tiene ningún animal.</p>
    <% } else { %>
      <% const animalesVivos = animales.filter((a) => a.salud_estado !== 'fallecido'); %>
      <% if (animalesVivos.length > 0) { %>
        <div class="patio" data-tema="<%= temaPatioActual %>" data-rivales='<%- JSON.stringify(paresRivales) %>'>
          <% animalesVivos.forEach((a) => { %>
            <img class="patio-avatar" data-id="<%= a.id %>" data-lento="<%= a.salud_estado !== 'sano' ? '1' : '0' %>" src="<%= a.imagen %>" alt="<%= a.nombre || a.especie %> caminando">
          <% }) %>
        </div>
      <% } %>

      <% animales.forEach((a) => { %>
        <section class="meta-card <%= a.salud_estado !== 'sano' ? 'meta-inactiva' : '' %>">
          <div class="meta-card-header meta-card-header-animal">
            <div class="animal-imagen-envoltura">
              <img class="animal-imagen" src="<%= a.imagen %>" alt="<%= a.especie %> en etapa <%= a.etapaVida %>" loading="lazy">
              <% if (a.accesorio) { %>
                <span class="animal-accesorio-badge" title="<%= a.accesorio %>"><%- include('partials/accesorio-icono', { nombre: a.accesorio }) %></span>
              <% } %>
            </div>
            <div>
              <h2><%= a.nombre || ('Sin nombre (' + a.especie + ')') %><% if (a.es_legendario) { %> ✨<% } %></h2>
              <span class="meta-estado-badge"><%= a.salud_estado %></span>
            </div>
          </div>
          <p class="meta-progreso-texto">
            <%= a.especie.charAt(0).toUpperCase() + a.especie.slice(1) %><% if (a.es_legendario) { %> — <strong>legendario</strong><% } %>
            — <%= a.etapaVida %>
          </p>
          <p class="meta-progreso-texto">
            <% Object.entries(a.alelosExpresados).filter(([locus]) => locus !== 'salud').forEach(([locus, alelo], i) => { %>
              <% if (i > 0) { %> · <% } %><code><%= locus %>: <%= alelo %></code>
            <% }) %>
          </p>

          <%
            const todosMisCandidatos = (a.esAdulto && a.salud_estado !== 'fallecido') ? (misAnimalesPorEspecie[a.especie] || []) : [];
            const misCandidatos = todosMisCandidatos.filter((m) => afinidadPares[m.id + '-' + a.id] === undefined);
            const misCandidatosRivales = todosMisCandidatos.filter((m) => afinidadPares[m.id + '-' + a.id] !== undefined && afinidadPares[m.id + '-' + a.id] < umbralReconciliacion);
          %>
          <% if (misCandidatos.length > 0) { %>
            <form method="POST" class="meta-card-acciones form-cruce-amigo">
              <input type="hidden" name="animal_amigo_id" value="<%= a.id %>">
              <select name="mi_animal_id" aria-label="Cruzar con tu animal" required>
                <% misCandidatos.forEach((m) => { %>
                  <option value="<%= m.id %>"><%= m.nombre || ('Sin nombre #' + m.id) %></option>
                <% }) %>
              </select>
              <button type="submit">Pedir cruce</button>
            </form>
          <% } %>
          <% misCandidatosRivales.forEach((m) => { %>
            <form method="POST" action="/animales/<%= m.id %>/socializar" class="meta-card-acciones">
              <input type="hidden" name="con_id" value="<%= a.id %>">
              <button type="submit" class="btn-rival">
                🐾 Tu <%= m.nombre || ('#' + m.id) %> es rival -- Socializar (<%= afinidadPares[m.id + '-' + a.id] %>/<%= umbralReconciliacion %>)
              </button>
            </form>
          <% }) %>
        </section>
      <% }) %>
    <% } %>

    <% if (!error && arbolesGenealogicos.length > 0) { %>
      <section class="ajustes-grupo pared-familia">
        <h2>Pared de la familia</h2>
        <p class="ajustes-nota">Memoriales de animales que fallecieron y dejaron familia real -- padres, crías, o ambos.</p>
        <%- include('partials/arbol-genealogico', { arboles: arbolesGenealogicos }) %>
      </section>
    <% } %>
  </main>

<%- include('partials/scripts') %>
<script src="/patio.js" defer></script>
<script>
  // rama-visitar-casa-amigo: la ruta real es POST /animales/<mi_animal_id>/
  // solicitar-cruce-amigo -- <mi_animal_id> va en la URL, no en el body,
  // así que se arma la action justo antes de enviar según lo elegido en
  // el <select>. Sin esto habría que duplicar la ruta para aceptar el id
  // por body, y ya existe y está probada tal cual desde rama-cruzar-amigos.
  document.querySelectorAll('.form-cruce-amigo').forEach((form) => {
    form.addEventListener('submit', () => {
      const miAnimalId = form.querySelector('select[name="mi_animal_id"]').value;
      form.action = '/animales/' + miAnimalId + '/solicitar-cruce-amigo';
    });
  });
</script>
</body>
</html>
