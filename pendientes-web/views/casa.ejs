<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { titulo: 'Casa' }) %>
</head>
<body>
  <main>
<%- include('partials/nav') %>
    <h1><%- include('partials/icono', { nombre: 'pata' }) %> Casa</h1>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } else { %>
      <% if (personajeMain) { %>
        <div class="personaje-guia">
          <div class="personaje-guia-avatar"><%- include('partials/icono', { nombre: 'guia' }) %></div>
          <div class="personaje-guia-globo">
            <p class="personaje-guia-nombre"><%= personajeMainNombre %></p>
            <p class="personaje-guia-texto"><%= personajeMain.texto %></p>
            <% if (personajeMain.mostrarBoton) { %>
              <form method="POST" action="/personaje-main/marcar-intro-visto">
                <button type="submit">Entendido</button>
              </form>
            <% } %>
          </div>
        </div>
      <% } %>

      <p class="count">
        Nivel <%= nivelJugador %> · Espacio: <%= animales.length %> / <%= capacidadCasa %> · <%- include('partials/icono', { nombre: 'moneda' }) %> <%= saldoMoneda %>
        <% if (nacio) { %> — <span class="notificacion">¡Nació un animal nuevo!</span><% } %>
      </p>

      <% const animalesVivos = animales.filter((a) => a.salud_estado !== 'fallecido'); %>
      <% if (animalesVivos.length > 0) { %>
        <div class="patio">
          <% animalesVivos.forEach((a) => { %>
            <img class="patio-avatar" data-lento="<%= a.salud_estado !== 'sano' ? '1' : '0' %>" src="<%= a.imagen %>" alt="<%= a.nombre || a.especie %> caminando">
          <% }) %>
        </div>
      <% } %>

      <section class="ajustes-grupo">
        <h2>Ampliar la casa</h2>
        <p class="ajustes-nota">Subir de nivel también agranda la casa gratis -- esto es para conseguir espacio ya mismo.</p>
        <form method="POST" action="/casa/ampliar">
          <button type="submit" <%= saldoMoneda < costoProximoEspacio ? 'disabled' : '' %>>
            +1 espacio por <%= costoProximoEspacio %> <%- include('partials/icono', { nombre: 'moneda' }) %>
          </button>
        </form>
      </section>

      <section class="ajustes-grupo">
        <h2>Tienda de accesorios</h2>
        <p class="ajustes-nota">Se compran una vez por cuenta -- después los podés poner y sacar de cualquiera de tus animales cuando quieras.</p>
        <div class="tienda-accesorios">
          <% accesoriosDisponibles.forEach((acc) => { %>
            <% const yaComprado = accesoriosComprados.includes(acc); %>
            <div class="tienda-accesorio-item">
              <div class="tienda-accesorio-icono"><%- include('partials/accesorio-icono', { nombre: acc }) %></div>
              <span class="tienda-accesorio-nombre"><%= acc.charAt(0).toUpperCase() + acc.slice(1) %></span>
              <% if (yaComprado) { %>
                <span class="tienda-accesorio-comprado">Comprado</span>
              <% } else { %>
                <form method="POST" action="/accesorios/comprar">
                  <input type="hidden" name="accesorio" value="<%= acc %>">
                  <button type="submit" <%= saldoMoneda < costoAccesorio ? 'disabled' : '' %>>
                    <%= costoAccesorio %> <%- include('partials/icono', { nombre: 'moneda' }) %>
                  </button>
                </form>
              <% } %>
            </div>
          <% }) %>
        </div>
      </section>

      <% if (solicitudesRecibidas.length > 0) { %>
        <section class="ajustes-grupo">
          <h2>Solicitudes de cruce</h2>
          <% solicitudesRecibidas.forEach((s) => { %>
            <p class="ajustes-nota">
              <strong><%= s.solicitante_nombre %></strong> quiere cruzar su
              <%= s.nombre_animal_solicitante || ('animal #' + s.animal_propio_id) %> (<%= s.especie %>)
              con tu <%= s.nombre_mi_animal || ('animal #' + s.animal_ajeno_id) %>.
            </p>
            <form method="POST" action="/cruces-solicitudes/<%= s.id %>/responder" class="meta-card-acciones">
              <input type="hidden" name="respuesta" value="aceptar">
              <button type="submit">Aceptar</button>
            </form>
            <form method="POST" action="/cruces-solicitudes/<%= s.id %>/responder" class="meta-card-acciones">
              <input type="hidden" name="respuesta" value="rechazar">
              <button type="submit">Rechazar</button>
            </form>
          <% }) %>
        </section>
      <% } %>

      <% if (espaciosLibres > 0) { %>
        <section class="ajustes-grupo">
          <h2>Adoptar un animal</h2>
          <p class="ajustes-nota">Cada animal adoptado tiene rasgos sorteados al azar. Para intentar combinaciones raras, cruzá dos animales que ya tengas.</p>
          <form method="POST" action="/casa/adoptar" class="ajustes-form">
            <label for="adoptar-especie">Especie</label>
            <select name="especie" id="adoptar-especie" required>
              <% especies.forEach((e) => { %>
                <option value="<%= e %>"><%= e.charAt(0).toUpperCase() + e.slice(1) %></option>
              <% }) %>
            </select>
            <button type="submit">Adoptar</button>
          </form>
        </section>
      <% } else { %>
        <p class="empty">Tu casa está al límite de espacio -- sube de nivel o consigue más espacio para adoptar o cruzar animales nuevos.</p>
      <% } %>

      <% if (animales.length === 0) { %>
        <p class="empty">Todavía no tienes ningún animal. Adoptá el primero arriba.</p>
      <% } else { %>
        <% animales.forEach((a) => { %>
          <section class="meta-card <%= a.salud_estado !== 'sano' ? 'meta-inactiva' : '' %>">
            <div class="meta-card-header meta-card-header-animal">
              <div class="animal-imagen-envoltura">
                <img class="animal-imagen" src="<%= a.imagen %>" alt="<%= a.especie %> en etapa <%= a.etapaVida %>" loading="lazy">
                <% if (a.accesorio) { %>
                  <span class="animal-accesorio-badge" title="<%= a.accesorio %>"><%- include('partials/accesorio-icono', { nombre: a.accesorio }) %></span>
                <% } %>
              </div>
              <div>
                <h2><%= a.nombre || ('Sin nombre (' + a.especie + ')') %><% if (a.es_legendario) { %> ✨<% } %></h2>
                <span class="meta-estado-badge"><%= a.salud_estado %></span>
              </div>
            </div>
            <p class="meta-progreso-texto">
              <%= a.especie.charAt(0).toUpperCase() + a.especie.slice(1) %><% if (a.es_legendario) { %> — <strong>legendario</strong><% } %>
              <% if (a.padre_id || a.madre_id) { %> — nacido de cría<% } else { %> — adoptado<% } %>
              — <%= a.etapaVida %><% if (!a.esAdulto) { %> (adulto a los <%= edadAdultoDias %> días desde que nació)<% } %>
            </p>
            <p class="meta-progreso-texto">
              <% Object.entries(a.alelosExpresados).filter(([locus]) => locus !== 'salud').forEach(([locus, alelo], i) => { %>
                <% if (i > 0) { %> · <% } %><code><%= locus %>: <%= alelo %></code>
              <% }) %>
            </p>

            <form method="POST" action="/animales/<%= a.id %>/nombrar" class="meta-card-acciones">
              <input type="text" name="nombre" placeholder="Ponle un nombre" value="<%= a.nombre || '' %>" maxlength="30" style="width:auto;display:inline-block;">
              <button type="submit">Guardar nombre</button>
            </form>

            <% if (accesoriosComprados.length > 0) { %>
              <form method="POST" action="/animales/<%= a.id %>/equipar-accesorio" class="meta-card-acciones">
                <select name="accesorio" aria-label="Accesorio">
                  <option value="" <%= !a.accesorio ? 'selected' : '' %>>Ninguno</option>
                  <% accesoriosComprados.forEach((acc) => { %>
                    <option value="<%= acc %>" <%= a.accesorio === acc ? 'selected' : '' %>><%= acc.charAt(0).toUpperCase() + acc.slice(1) %></option>
                  <% }) %>
                </select>
                <button type="submit">Poner</button>
              </form>
            <% } %>

            <% if (a.salud_estado === 'fallecido') { %>
              <form method="POST" action="/animales/<%= a.id %>/revivir" class="meta-card-acciones">
                <button type="submit"><%- include('partials/icono', { nombre: 'llama' }) %> Revivir</button>
              </form>
            <% } else { %>
              <form method="POST" action="/animales/<%= a.id %>/alimentar" class="meta-card-acciones">
                <button type="submit">Alimentar</button>
              </form>
              <% if (a.esAdulto) { %>
                <% const parejas = animales.filter((otro) => otro.id !== a.id && otro.especie === a.especie && otro.salud_estado !== 'fallecido' && otro.esAdulto); %>
                <% if (parejas.length > 0) { %>
                  <form method="POST" action="/animales/<%= a.id %>/cruzar" class="meta-card-acciones">
                    <select name="pareja_id" aria-label="Cruzar con" required>
                      <% parejas.forEach((p) => { %>
                        <option value="<%= p.id %>"><%= p.nombre || ('Sin nombre #' + p.id) %></option>
                      <% }) %>
                    </select>
                    <button type="submit">Cruzar</button>
                  </form>
                <% } %>
                <% const candidatosAmigos = candidatosPorEspecie[a.especie] || []; %>
                <% if (candidatosAmigos.length > 0) { %>
                  <form method="POST" action="/animales/<%= a.id %>/solicitar-cruce-amigo" class="meta-card-acciones">
                    <select name="animal_amigo_id" aria-label="Cruzar con el animal de un amigo" required>
                      <% candidatosAmigos.forEach((c) => { %>
                        <option value="<%= c.id %>"><%= c.nombre_usuario %>: <%= c.nombre || ('Sin nombre #' + c.id) %></option>
                      <% }) %>
                    </select>
                    <button type="submit">Pedir cruce con amigo</button>
                  </form>
                <% } %>
              <% } %>
            <% } %>
          </section>
        <% }) %>
      <% } %>

      <% if (arbolesGenealogicos.length > 0) { %>
        <section class="ajustes-grupo pared-familia">
          <h2>Pared de la familia</h2>
          <p class="ajustes-nota">Memoriales de animales que fallecieron y dejaron familia real -- padres, crías, o ambos.</p>
          <%- include('partials/arbol-genealogico', { arboles: arbolesGenealogicos }) %>
        </section>
      <% } %>
    <% } %>
  </main>

<%- include('partials/scripts') %>
<script src="/patio.js" defer></script>
</body>
</html>
