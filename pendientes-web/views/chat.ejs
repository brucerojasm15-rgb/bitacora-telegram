<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { titulo: 'Chat' }) %>
</head>
<body>
  <main>
<%- include('partials/nav') %>
    <h1>💬 Chat</h1>

    <% if (!amistadId) { %>
      <p class="empty">Indica una amistad con <code>?amistad_id=</code> para ver la conversación.</p>
    <% } else { %>
      <form method="GET" action="/chat" class="filtro-rango">
        <input type="number" name="amistad_id" value="<%= amistadId %>" min="1" required>
        <input type="text" name="buscar" value="<%= buscar %>" placeholder="Buscar mensajes...">
        <button type="submit">Ver</button>
        <% if (buscar) { %><a href="/chat?amistad_id=<%= amistadId %>" class="btn-link">Limpiar</a><% } %>
      </form>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } else if (mensajes.length === 0) { %>
        <p class="empty"><%= buscar ? 'Ningún mensaje coincide con "' + buscar + '".' : 'Todavía no hay mensajes en esta conversación.' %></p>
      <% } else { %>
        <%
          const sinLeerPrevios = mensajes.filter((m) => !m.leido && m.autor_id !== usuarioId).length;
        %>
        <% if (sinLeerPrevios > 0) { %>
          <p class="notificacion">
            🔔 Tenías <%= sinLeerPrevios %> mensaje<%= sinLeerPrevios === 1 ? '' : 's' %> sin leer. Se marcaron como leídos al abrir el chat.
          </p>
        <% } %>
        <ul class="chat-mensajes">
          <% mensajes.forEach((m) => {
            const esMio = m.autor_id === usuarioId;
          %>
            <li class="<%= esMio ? 'mensaje-propio' : 'mensaje-otro' %>">
              <% if (!esMio) { %><span class="autor">Usuario <%= m.autor_id %></span><% } %>
              <span class="texto"><%= m.texto %></span>
              <span class="fecha">
                <%= new Date(m.fecha).toLocaleString('es-PE', { timeZone: 'America/Lima' }) %>
                <% if (!esMio && !m.leido) { %>
                  <span class="no-leido" title="Mensaje nuevo">●</span>
                <% } else if (esMio) { %>
                  <span class="visto" title="<%= m.leido ? 'Visto' : 'Enviado' %>"><%= m.leido ? '✓✓' : '✓' %></span>
                <% } %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <form method="POST" action="/mensajes" class="nuevo">
        <input type="hidden" name="amistad_id" value="<%= amistadId %>">
        <input type="text" name="texto" placeholder="Escribe un mensaje..." required>
        <button type="submit">Enviar</button>
      </form>
    <% } %>
  </main>

<%- include('partials/scripts') %>
</body>
</html>
