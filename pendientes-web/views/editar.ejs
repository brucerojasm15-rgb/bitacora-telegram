<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { titulo: 'Editar pendiente' }) %>
</head>
<body>
  <main>
<%- include('partials/nav') %>
    <h1><%- include('partials/icono', { nombre: 'lapiz' }) %> Editar pendiente</h1>

    <form method="POST" action="/pendientes/<%= pendiente.id %>/editar" class="editar-form">
      <textarea name="texto" rows="6" required><%= pendiente.texto %></textarea>
      <label for="categoria">Categoría</label>
      <select name="categoria" id="categoria">
        <option value="">Sin categoría</option>
        <% categorias.forEach((c) => { %>
          <option value="<%= c %>" <%= pendiente.categoria === c ? 'selected' : '' %>>#<%= c %></option>
        <% }) %>
      </select>
      <div class="acciones-form">
        <button type="submit">Guardar</button>
        <a href="/" class="btn-link">Cancelar</a>
      </div>
    </form>

    <form method="POST" action="/pendientes/<%= pendiente.id %>/asignar" class="asignar-form">
      <label for="nombre_usuario">Asignar a un amigo</label>
      <select name="nombre_usuario" id="nombre_usuario">
        <option value="">Sin asignar</option>
        <% amigos.forEach((a) => { %>
          <option value="<%= a.nombre_usuario %>" <%= pendiente.asignado_a === a.id ? 'selected' : '' %>>@<%= a.nombre_usuario %></option>
        <% }) %>
      </select>
      <button type="submit">Guardar asignación</button>
    </form>
  </main>

<%- include('partials/scripts') %>
</body>
</html>
