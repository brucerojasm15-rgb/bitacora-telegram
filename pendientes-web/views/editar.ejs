<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { titulo: 'Editar pendiente' }) %>
</head>
<body>
  <main>
<%- include('partials/nav', { clave }) %>
    <h1>✏️ Editar pendiente</h1>

    <form method="POST" action="/pendientes/<%= pendiente.id %>/editar" class="editar-form">
      <input type="hidden" name="clave" value="<%= clave %>">
      <textarea name="texto" rows="6" required><%= pendiente.texto %></textarea>
      <div class="acciones-form">
        <button type="submit">Guardar</button>
        <a href="/?clave=<%= clave %>" class="btn-link">Cancelar</a>
      </div>
    </form>
  </main>

<%- include('partials/scripts', { clave }) %>
</body>
</html>
