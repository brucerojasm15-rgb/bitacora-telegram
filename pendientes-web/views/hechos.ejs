<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { titulo: 'Hechos' }) %>
</head>
<body>
  <main>
<%- include('partials/nav', { clave }) %>
    <h1>✅ Hechos</h1>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } else if (hechos.length === 0) { %>
      <p class="empty">No hay nada registrado todavía.</p>
    <% } else { %>
      <p class="count"><%= hechos.length %> hecho(s)</p>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Texto</th>
            <th>Cuándo</th>
          </tr>
        </thead>
        <tbody>
          <% hechos.forEach((h, idx) => { %>
            <tr>
              <td><%= idx + 1 %></td>
              <td><%= h.texto %></td>
              <td><%= new Date(h.cuando).toLocaleString('es-PE', { timeZone: 'America/Lima' }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>

<%- include('partials/scripts', { clave }) %>
</body>
</html>
