<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { titulo: 'Ideas' }) %>
</head>
<body>
  <main>
<%- include('partials/nav') %>
    <h1><%- include('partials/icono', { nombre: 'bombilla' }) %> Ideas</h1>

<%- include('partials/filtro-rango', { rango, q }) %>
    <form method="GET" action="/ideas" class="filtro-rango">
      <input type="hidden" name="rango" value="<%= rango %>">
      <input type="text" name="q" value="<%= q %>" placeholder="Buscar ideas...">
      <button type="submit">Buscar</button>
      <% if (q) { %><a href="/ideas?rango=<%= rango %>" class="btn-link">Limpiar</a><% } %>
    </form>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } else if (ideas.length === 0) { %>
      <p class="empty">No hay ideas todavía.</p>
    <% } else { %>
      <p class="count"><%= ideas.length %> idea(s)</p>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Idea</th>
            <th>Estado</th>
            <th>Fecha</th>
          </tr>
        </thead>
        <tbody>
          <% ideas.forEach((i, idx) => { %>
            <tr>
              <td><%= idx + 1 %></td>
              <td><%= i.idea %></td>
              <td><%= i.estado || '-' %></td>
              <td><%= new Date(i.fecha).toLocaleString('es-PE', { timeZone: 'America/Lima' }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>

<%- include('partials/scripts') %>
</body>
</html>
