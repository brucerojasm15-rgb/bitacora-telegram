<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { titulo: 'Pendientes' }) %>
</head>
<body>
  <main>
<%- include('partials/nav') %>
    <h1>📋 Pendientes</h1>

    <button id="activar-notificaciones" type="button" class="secundario">🔔 Activar notificaciones</button>

    <form method="POST" action="/pendientes" class="nuevo">
      <input type="text" name="texto" id="nuevo-pendiente" placeholder="Nuevo pendiente..." required>
      <button type="submit">Agregar</button>
    </form>

    <div id="lista">
      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } else if (pendientes.length === 0) { %>
        <p class="empty">No hay pendientes. 🎉</p>
      <% } else { %>
        <p class="count" id="contador"><%= pendientes.length %> pendiente(s)</p>
        <table id="tabla-pendientes">
          <thead>
            <tr>
              <th>#</th>
              <th>Actividad</th>
              <th>Creado</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% pendientes.forEach((p, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= p.texto %></td>
                <td><%= new Date(p.creado).toLocaleString('es-PE', { timeZone: 'America/Lima' }) %></td>
                <td>
                  <% if (p.necesita_reflexion) { %>
                    <form method="POST" action="/pendientes/<%= p.id %>/reflexion" class="reflexion-form">
                      <label>¿Qué pasa?</label>
                      <input type="text" name="respuesta" required>
                      <button type="submit">Guardar</button>
                    </form>
                  <% } else { %>
                    <div class="acciones">
                      <form method="POST" action="/pendientes/<%= p.id %>/completar" class="completar-form">
                        <button type="submit">✅ Completar</button>
                      </form>
                      <form method="POST" action="/pendientes/<%= p.id %>/posponer" class="posponer-form">
                        <button type="submit">⏳ Posponer</button>
                      </form>
                      <a href="/pendientes/<%= p.id %>/editar" class="btn-link">✏️ Editar</a>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>

  <script>
    if (window.location.hash === '#nuevo-pendiente') {
      document.getElementById('nuevo-pendiente')?.focus();
    }

    function urlBase64ToUint8Array(base64String) {
      const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
      const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
      const rawData = window.atob(base64);
      return Uint8Array.from([...rawData].map((c) => c.charCodeAt(0)));
    }

    document.getElementById('activar-notificaciones')?.addEventListener('click', async () => {
      try {
        if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
          alert('Este navegador no soporta notificaciones push.');
          return;
        }
        const permiso = await Notification.requestPermission();
        if (permiso !== 'granted') {
          alert('No diste permiso para las notificaciones.');
          return;
        }
        const registro = await navigator.serviceWorker.ready;
        const suscripcion = await registro.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array('<%= vapidPublicKey %>'),
        });
        await fetch('/suscribir', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ subscription: suscripcion.toJSON() }),
        });
        alert('¡Notificaciones activadas!');
      } catch (err) {
        alert('No se pudo activar: ' + err.message);
      }
    });

    function quitarFila(fila) {
      const tbody = document.querySelector('#tabla-pendientes tbody');
      if (fila) fila.remove();
      if (!tbody || tbody.children.length === 0) {
        document.getElementById('lista').innerHTML = '<p class="empty">No hay pendientes. 🎉</p>';
      } else {
        document.getElementById('contador').textContent = `${tbody.children.length} pendiente(s)`;
      }
    }

    document.querySelectorAll('.completar-form').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fila = form.closest('tr');
        try {
          const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
          if (!res.ok) {
            window.location.reload();
            return;
          }
          if (!fila) return;
          const celdaAcciones = fila.querySelector('td:last-child');
          if (celdaAcciones) celdaAcciones.innerHTML = '<span class="check-confirm">✔</span>';
          fila.classList.add('fila-completada');
          setTimeout(() => {
            fila.classList.add('fila-saliendo');
            setTimeout(() => quitarFila(fila), 350);
          }, 500);
        } catch (err) {
          form.submit();
        }
      });
    });

    document.querySelectorAll('.posponer-form, .reflexion-form').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fila = form.closest('tr');
        if (fila) fila.classList.add('fila-posponiendo');
        try {
          await fetch(form.action, { method: 'POST', body: new FormData(form) });
          if (fila) fila.classList.add('fila-saliendo');
          setTimeout(() => window.location.reload(), 280);
        } catch (err) {
          form.submit();
        }
      });
    });
  </script>
<%- include('partials/scripts') %>
</body>
</html>
