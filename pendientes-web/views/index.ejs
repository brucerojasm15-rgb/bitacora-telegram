<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pendientes</title>
  <link rel="stylesheet" href="/style.css">

  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1c1c1e">
  <link rel="icon" href="/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Pendientes">
</head>
<body>
  <main>
    <h1>📋 Pendientes</h1>

    <form method="POST" action="/pendientes" class="nuevo">
      <input type="hidden" name="clave" value="<%= clave %>">
      <input type="text" name="texto" placeholder="Nuevo pendiente..." required>
      <button type="submit">Agregar</button>
    </form>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } else if (pendientes.length === 0) { %>
      <p class="empty">No hay pendientes. 🎉</p>
    <% } else { %>
      <p class="count"><%= pendientes.length %> pendiente(s)</p>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Actividad</th>
            <th>Creado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% pendientes.forEach((p, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= p.texto %></td>
              <td><%= new Date(p.creado).toLocaleString('es-PE', { timeZone: 'America/Lima' }) %></td>
              <td>
                <form method="POST" action="/pendientes/<%= p.id %>/completar">
                  <input type="hidden" name="clave" value="<%= clave %>">
                  <button type="submit">✅ Completar</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>

  <script>
    localStorage.setItem('clave', '<%= clave %>');

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>
</body>
</html>
