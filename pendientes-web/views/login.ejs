<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { titulo: 'Iniciar sesión' }) %>
</head>
<body>
  <main class="login-main">
    <h1>🔐 Bitácora</h1>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <form method="POST" action="/login" class="login-form">
      <input type="text" name="nombre_usuario" placeholder="Usuario" autocapitalize="none" autocorrect="off" spellcheck="false" autocomplete="username" required autofocus>
      <input type="password" name="pin" placeholder="PIN" inputmode="numeric" required>
      <button type="submit">Entrar</button>
    </form>
  </main>

<%- include('partials/scripts') %>
</body>
</html>
