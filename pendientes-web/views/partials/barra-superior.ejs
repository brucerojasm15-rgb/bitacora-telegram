<%
  /* rama-interfaz (Fase 4 de v0.2): barra superior fija en TODAS las
     pantallas (a diferencia de nav-bottom, que solo se ve en mobile) --
     mini planta (misma ilustración de partials/planta.ejs, a tamaño chico),
     racha con llama, contador de semillas. Los datos vienen de
     res.locals.barraSuperior, poblado por un middleware en server.js para
     TODA request logueada (mismo criterio que ya usaba res.locals.tema) --
     así ninguna de las 34 rutas que hacen res.render tiene que acordarse de
     pasarlo a mano.
     Si no hay sesión (páginas públicas: /login, /registro, /recuperar...)
     barraSuperior es null y esta barra no se dibuja nada -- esas páginas no
     tienen `main` corrido hacia abajo tampoco (ver la regla CSS de
     body.sin-barra-superior).
     rama-inicio-planta: suma 2 botones (casa, cuenta) -- reemplaza a
     `.nav-top` de rama-nav-rediseno entero (se rompía en mobile real, ver
     COORDINACION.md). Ahora es la ÚNICA barra fija de la app: "Casa"
     vuelve a /captura (la pantalla principal nueva, planta + Captura
     rápida), "Cuenta" abre el menú de usuario en pantalla completa
     (`.menu-pantalla`, ver partials/nav.ejs).
     rama-chat-visible: suma el botón de chat con amigos -- antes solo se
     llegaba entrando a /amigos desde el menú de pantalla completa y
     buscando el link de cada amigo, así que quedaba escondido. Usa
     GET /notificaciones (ya existía, nunca se había conectado a nada --
     ver el comentario de esa ruta en server.js) para el contador de sin
     leer, poblado client-side (public/scripts.ejs de abajo), no server-
     side -- evita sumarle una consulta más al middleware que corre en
     CADA request logueado. */
  const datos = typeof barraSuperior !== 'undefined' ? barraSuperior : null;
%>
<% if (datos) { %>
  <div class="barra-superior" id="barra-superior" data-racha="<%= datos.racha %>" data-usuario="<%= datos.usuarioId %>">
    <a href="/captura" class="barra-superior-boton" title="Inicio" aria-label="Inicio">
      <%- include('icono', { nombre: 'casa' }) %>
    </a>
    <div class="barra-superior-centro">
      <div class="barra-superior-planta" id="barra-superior-planta">
        <%- include('planta', { especie: datos.especie, etapa: datos.etapa, tamano: 34, idSufijo: 'barra', skin: datos.skin }) %>
      </div>
      <div class="barra-superior-dato barra-superior-racha">
        <%- include('icono', { nombre: 'llama' }) %>
        <span><%= datos.racha %></span>
      </div>
      <div class="barra-superior-dato barra-superior-semillas">
        <%- include('icono', { nombre: 'semilla' }) %>
        <span><%= datos.semillas %></span>
      </div>
    </div>
    <a href="/amigos" class="barra-superior-boton barra-superior-chat" id="btn-chat-amigos" title="Chat con amigos" aria-label="Chat con amigos">
      <%- include('icono', { nombre: 'chat' }) %>
      <span class="barra-superior-badge" id="badge-chat-amigos" hidden></span>
    </a>
    <button type="button" class="barra-superior-boton" id="btn-menu-usuario" aria-haspopup="true" aria-expanded="false" aria-controls="menu-pantalla" title="Menú" aria-label="Menú">
      <%- include('icono', { nombre: 'cuenta' }) %>
    </button>
  </div>
<% } %>
