<%
  /* rama-inicio-planta: reemplaza TODO el sistema de rama-nav-rediseno
     (`.nav-top` fija + `.nav-expandido` + `.nav-drawer`) -- se rompía en
     un navegador mobile real (confirmado por el usuario vía control
     remoto: el panel de accesos ocasionales quedaba como texto plano
     subrayado en vez de un panel flotante). En vez de parchear eso, el
     usuario pidió llevar zentIA al esquema de una app de referencia que
     mostró (mapa + buscador tipo chat en la pantalla principal, menú de
     funciones en grilla aparte): acá la "pantalla principal" es
     `/captura` (ver ese archivo -- planta grande + saludo + la Captura
     rápida de siempre) y el "menú aparte" es `.menu-pantalla`, este
     mismo partial.

     Ya no hay una barra de navegación con links sueltos en cada página --
     la única barra fija es `partials/barra-superior.ejs` (mini planta +
     racha + semillas, como siempre, más 2 botones nuevos: "Casa" vuelve
     a /captura, "Cuenta" abre este menú). Todos los accesos que antes
     estaban repartidos entre primarios/ocasionales/drawer ahora viven
     juntos acá, en una sola grilla -- ya no hace falta esa separación
     porque no hay que elegir qué entra en una barra angosta.

     Se elimina el reordenado adaptativo por uso (`zentia_nav_uso` de
     rama-nav-rediseno): la app de referencia no lo hace y una grilla fija
     no tiene el mismo problema de espacio que una barra angosta.

     rama-mundo-caminable: esta grilla pasa a ser solo "Herramientas" --
     los 6 items del "juego" (Mi planta, Hablar con tu planta, Mercado,
     Logros, Casa, Plaza) se sacaron de acá y ahora viven en /mundo (mapa
     caminable nuevo, ver views/mundo.ejs + public/mundo.js), reachable
     desde el ícono nuevo al costado derecho de /captura. El ícono
     "Cuenta" de la barra superior sigue abriendo ESTA grilla (ya
     filtrada) sin cambios. */
%>
<%- include('barra-superior') %>
  <div class="menu-pantalla" id="menu-pantalla" role="menu" aria-label="Herramientas" hidden>
    <div class="menu-pantalla-cerrar">
      <button type="button" id="btn-menu-cerrar" aria-label="Cerrar menú">
        <%- include('icono', { nombre: 'x' }) %>
      </button>
    </div>
    <div class="menu-pantalla-grilla">
      <a href="/" class="menu-pantalla-item" role="menuitem">
        <span class="menu-pantalla-item-icono"><%- include('icono', { nombre: 'portapapeles' }) %></span>
        <span>Pendientes</span>
      </a>
      <a href="/ideas" class="menu-pantalla-item" role="menuitem">
        <span class="menu-pantalla-item-icono"><%- include('icono', { nombre: 'bombilla' }) %></span>
        <span>Ideas</span>
      </a>
      <a href="/recordatorios" class="menu-pantalla-item" role="menuitem">
        <span class="menu-pantalla-item-icono"><%- include('icono', { nombre: 'reloj' }) %></span>
        <span>Recordatorios</span>
      </a>
      <a href="/hechos" class="menu-pantalla-item" role="menuitem">
        <span class="menu-pantalla-item-icono"><%- include('icono', { nombre: 'check' }) %></span>
        <span>Hechos</span>
      </a>
      <a href="/amigos" class="menu-pantalla-item" role="menuitem">
        <span class="menu-pantalla-item-icono"><%- include('icono', { nombre: 'personas' }) %></span>
        <span>Amigos</span>
      </a>
      <a href="/chat-general" class="menu-pantalla-item" role="menuitem">
        <span class="menu-pantalla-item-icono"><%- include('icono', { nombre: 'chat' }) %></span>
        <span>Chat general</span>
      </a>
      <a href="/metas" class="menu-pantalla-item" role="menuitem">
        <span class="menu-pantalla-item-icono"><%- include('icono', { nombre: 'meta' }) %></span>
        <span>Metas</span>
      </a>
      <a href="/estancados" class="menu-pantalla-item" role="menuitem">
        <span class="menu-pantalla-item-icono"><%- include('icono', { nombre: 'arena' }) %></span>
        <span>Estancados</span>
      </a>
      <a href="/estadisticas" class="menu-pantalla-item" role="menuitem">
        <span class="menu-pantalla-item-icono"><%- include('icono', { nombre: 'grafico' }) %></span>
        <span>Estadísticas</span>
      </a>
      <a href="/tutorial" class="menu-pantalla-item" role="menuitem">
        <span class="menu-pantalla-item-icono"><%- include('icono', { nombre: 'guia' }) %></span>
        <span>Tutorial<% if (typeof tutorialCapitulosPendientes !== 'undefined' && tutorialCapitulosPendientes > 0) { %> <span class="no-leido" title="Capítulos pendientes">●</span><% } %></span>
      </a>
      <a href="/ajustes" class="menu-pantalla-item" role="menuitem">
        <span class="menu-pantalla-item-icono"><%- include('icono', { nombre: 'ajustes' }) %></span>
        <span>Ajustes</span>
      </a>
      <a href="/exportar" class="menu-pantalla-item" role="menuitem">
        <span class="menu-pantalla-item-icono"><%- include('icono', { nombre: 'descarga' }) %></span>
        <span>Exportar</span>
      </a>
      <button type="button" class="menu-pantalla-item" data-toggle-tema role="menuitem">
        <span class="menu-pantalla-item-icono"><%- include('icono', { nombre: 'sol' }) %></span>
        <span>Tema</span>
      </button>
      <form method="POST" action="/logout" class="menu-pantalla-item-form" role="menuitem">
        <button type="submit" class="menu-pantalla-item menu-pantalla-item-peligro">
          <span class="menu-pantalla-item-icono"><%- include('icono', { nombre: 'salir' }) %></span>
          <span>Cerrar sesión</span>
        </button>
      </form>
    </div>
  </div>

  <!-- rama-logros: celebración de desbloqueo, ver res.locals.logrosNuevos
       en el middleware global de server.js -- aparece en el próximo
       render de CUALQUIER página después de un desbloqueo (no hace falta
       enganchar un query param a cada ruta que puede desbloquear uno).
       Auto-dismiss por JS, ver partials/scripts.ejs. -->
  <% if (typeof logrosNuevos !== 'undefined' && logrosNuevos.length) { %>
    <div id="toasts-logro" aria-live="polite">
      <% logrosNuevos.forEach((l) => { %>
        <div class="toast-logro">
          <%- include('icono', { nombre: 'trofeo' }) %>
          <span><strong>¡Logro desbloqueado!</strong><small><%= l.nombre %></small></span>
        </div>
      <% }) %>
    </div>
  <% } %>
