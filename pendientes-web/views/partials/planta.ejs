<%
/* rama-ia-companera-fase1: ilustración de la planta compañera, 4 especies x
   4 etapas de crecimiento. En "semilla" las 4 especies se ven iguales (todavía
   no hay nada que las distinga visualmente) — a partir de "brote" cada una
   tiene su propia silueta. La de "adulta" de monstera reusa exactamente el
   mismo <path>/<mask> de partials/monstera.ejs para quedar coherente con el
   resto de la marca. Se incluye pasando { especie, etapa, tamano, idSufijo }.
   `etapa` es el índice 0-3 (semilla/brote/joven/adulta). */
const tam = typeof tamano !== 'undefined' ? tamano : 96;
const sufijo = typeof idSufijo !== 'undefined' ? idSufijo : 'p';
const especieSel = ['monstera', 'cactus', 'ficus', 'suculenta'].includes(especie) ? especie : 'monstera';
const etapaSel = Number.isInteger(etapa) && etapa >= 0 && etapa <= 3 ? etapa : 0;

// rama-fix-skin-planta: mismos 4 colores que SKIN_COLORES en server.js --
// duplicado a propósito acá (solo 4 entradas) en vez de hacer viajar el
// mapa completo a cada una de las 6 vistas que incluyen este partial, lo
// único que necesitan mandar es el nombre del skin. `skin` es opcional
// (la mayoría de los llamadores todavía no lo pasan -- login.ejs lo
// aplica client-side, ver partials/scripts.ejs) -- sin skin o con
// "clasico", no se agrega ningún style inline, cero cambio de
// comportamiento para quien no lo use.
const SKINS_PLANTA = {
  clasico: { accent: '#16A34A', tono: '#D4A574' },
  alegre: { accent: '#F59E0B', tono: '#FBBF24' },
  zen: { accent: '#0EA5E9', tono: '#7DD3FC' },
  nocturno: { accent: '#7C3AED', tono: '#A78BFA' },
};
const skinSel = typeof skin !== 'undefined' && SKINS_PLANTA[skin] ? skin : 'clasico';
const colorSkin = SKINS_PLANTA[skinSel];
const estiloSkin = skinSel !== 'clasico' ? `--accent:${colorSkin.accent};--tono:${colorSkin.tono};` : '';

const SUELO = '<ellipse cx="50" cy="86" rx="28" ry="7" fill="var(--accent)" opacity="0.2"></ellipse>';

const SEMILLA = SUELO + '<ellipse cx="50" cy="76" rx="9" ry="12" fill="var(--tono)"></ellipse><path d="M50 64c3 4 3 8 0 12" stroke="var(--accent)" stroke-width="2" fill="none" stroke-linecap="round"></path>';

const PLANTAS = {
  monstera: [
    SEMILLA,
    SUELO + '<path d="M50 86V60" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"></path><path d="M50 62c-14-2-16 12-4 14 3-6 4-10 4-14Z" fill="var(--accent)"></path>',
    SUELO + '<path d="M50 86V44" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"></path><path d="M50 50c-16-4-20 12-6 16 4-6 6-10 6-16Z" fill="var(--accent)"></path><path d="M50 62c14-3 17 10 5 13-4-5-6-8-5-13Z" fill="var(--accent)"></path><circle cx="47" cy="56" r="2.4" fill="var(--bg)"></circle>',
    SUELO + '<path d="M50 86V52" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"></path><g transform="translate(0 -6) scale(0.62) translate(29 8)"><path d="M50 8 C74 10 90 30 88 52 C86 76 66 92 48 90 C26 88 10 70 12 48 C14 26 30 6 50 8 Z" fill="var(--accent)" mask="url(#planta-mask-' + sufijo + ')"></path></g>',
  ],
  cactus: [
    SEMILLA,
    SUELO + '<rect x="44" y="62" width="12" height="24" rx="6" fill="var(--accent)"></rect><circle cx="47" cy="68" r="1.3" fill="var(--tono)"></circle><circle cx="53" cy="74" r="1.3" fill="var(--tono)"></circle>',
    SUELO + '<rect x="42" y="42" width="16" height="44" rx="8" fill="var(--accent)"></rect><path d="M44 58c-8 0-8 12 0 12" stroke="var(--accent)" stroke-width="6" fill="none" stroke-linecap="round"></path><circle cx="46" cy="50" r="1.4" fill="var(--tono)"></circle><circle cx="54" cy="60" r="1.4" fill="var(--tono)"></circle><circle cx="46" cy="70" r="1.4" fill="var(--tono)"></circle>',
    SUELO + '<rect x="40" y="30" width="20" height="56" rx="10" fill="var(--accent)"></rect><path d="M42 48c-10 0-10 16 0 16" stroke="var(--accent)" stroke-width="7" fill="none" stroke-linecap="round"></path><path d="M58 56c10 0 10 16 0 16" stroke="var(--accent)" stroke-width="7" fill="none" stroke-linecap="round"></path><circle cx="50" cy="26" r="6" fill="var(--tono)"></circle>' +
      Array.from({length: 5}).map((_, i) => '<circle cx="' + (44 + (i % 3) * 6) + '" cy="' + (38 + Math.floor(i / 3) * 14) + '" r="1.4" fill="var(--tono)"></circle>').join(''),
  ],
  ficus: [
    SEMILLA,
    SUELO + '<path d="M50 86V64" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"></path><ellipse cx="44" cy="60" rx="6" ry="4" fill="var(--accent)" transform="rotate(-20 44 60)"></ellipse><ellipse cx="57" cy="60" rx="6" ry="4" fill="var(--accent)" transform="rotate(20 57 60)"></ellipse>',
    SUELO + '<path d="M50 86V50" stroke="var(--accent)" stroke-width="4" stroke-linecap="round"></path><circle cx="50" cy="40" r="16" fill="var(--accent)"></circle><circle cx="38" cy="48" r="9" fill="var(--accent)"></circle><circle cx="62" cy="48" r="9" fill="var(--accent)"></circle>',
    SUELO + '<path d="M50 86V46M46 86l-4-14M54 86l4-14" stroke="var(--accent)" stroke-width="4" stroke-linecap="round" fill="none"></path><circle cx="50" cy="32" r="22" fill="var(--accent)"></circle><circle cx="32" cy="42" r="12" fill="var(--accent)"></circle><circle cx="68" cy="42" r="12" fill="var(--accent)"></circle>' +
      Array.from({length: 6}).map((_, i) => '<circle cx="' + (34 + (i % 3) * 16) + '" cy="' + (24 + Math.floor(i / 3) * 16) + '" r="1.6" fill="var(--bg)" opacity="0.6"></circle>').join(''),
  ],
  suculenta: [
    SEMILLA,
    SUELO + '<path d="M50 78c-6-8 0-16 0-16" stroke="var(--accent)" stroke-width="5" fill="none" stroke-linecap="round"></path><path d="M50 78c6-8 0-16 0-16" stroke="var(--accent)" stroke-width="5" fill="none" stroke-linecap="round"></path><path d="M50 78V64" stroke="var(--accent)" stroke-width="5" fill="none" stroke-linecap="round"></path>',
    SUELO +
      Array.from({length: 7}).map((_, i) => {
        const ang = (i / 7) * Math.PI * 2;
        const x = 50 + Math.cos(ang) * 13;
        const y = 74 + Math.sin(ang) * 9;
        const rot = (ang * 180) / Math.PI + 90;
        return '<ellipse cx="' + x.toFixed(1) + '" cy="' + y.toFixed(1) + '" rx="4.5" ry="11" fill="var(--accent)" transform="rotate(' + rot.toFixed(1) + ' ' + x.toFixed(1) + ' ' + y.toFixed(1) + ')"></ellipse>';
      }).join('') + '<circle cx="50" cy="74" r="5" fill="var(--tono)"></circle>',
    SUELO +
      Array.from({length: 9}).map((_, i) => {
        const ang = (i / 9) * Math.PI * 2;
        const x = 50 + Math.cos(ang) * 20;
        const y = 68 + Math.sin(ang) * 14;
        const rot = (ang * 180) / Math.PI + 90;
        return '<ellipse cx="' + x.toFixed(1) + '" cy="' + y.toFixed(1) + '" rx="6" ry="17" fill="var(--accent)" transform="rotate(' + rot.toFixed(1) + ' ' + x.toFixed(1) + ' ' + y.toFixed(1) + ')"></ellipse>';
      }).join('') + '<circle cx="50" cy="68" r="7" fill="var(--tono)"></circle>',
  ],
};
%><svg width="<%= tam %>" height="<%= tam %>" viewBox="0 0 100 100" role="img" data-skin="<%= skinSel %>" style="<%= estiloSkin %>" aria-label="Ilustración de tu planta compañera (<%= especieSel %>, etapa <%= etapaSel + 1 %> de 4)">
  <defs>
    <mask id="planta-mask-<%= sufijo %>">
      <rect x="0" y="0" width="100" height="100" fill="white"></rect>
      <ellipse cx="42" cy="34" rx="6" ry="9" fill="black"></ellipse>
      <ellipse cx="62" cy="30" rx="5" ry="8" fill="black" transform="rotate(20 62 30)"></ellipse>
      <ellipse cx="38" cy="58" rx="5" ry="8" fill="black" transform="rotate(-15 38 58)"></ellipse>
      <ellipse cx="60" cy="60" rx="6" ry="9" fill="black" transform="rotate(12 60 60)"></ellipse>
    </mask>
  </defs>
  <%- PLANTAS[especieSel][etapaSel] %>
</svg>
