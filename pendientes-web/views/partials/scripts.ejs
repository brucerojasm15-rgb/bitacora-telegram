  <script src="/sonidos.js"></script>
  <script>
    // rama-login-lockscreen: cachea "quién fue el último en entrar en este
    // dispositivo" para que /login pueda mostrarse como pantalla de
    // bloqueo (nombre + especie de su planta + con qué método entra) en
    // vez del formulario completo con usuario y contraseña cada vez. Solo
    // texto/nombre de especie -- nunca el PIN/contraseña, nunca datos
    // sensibles. Se reescribe en CADA página logueada (no solo al hacer
    // login) para que si cambia de cuenta, la próxima carga de cualquier
    // página ya autenticada la deje al día.
    (function () {
      const nombreUsuario = <%- JSON.stringify(typeof nombreUsuario !== 'undefined' ? nombreUsuario : null) %>;
      if (!nombreUsuario) return;
      try {
        const metodo = <%- JSON.stringify(typeof metodoLogin !== 'undefined' && metodoLogin ? metodoLogin : 'pin') %>;
        const email = <%- JSON.stringify(typeof emailUsuario !== 'undefined' ? emailUsuario : null) %>;
        // Si el método fue "email" pero no hay email vinculado (no debería
        // pasar, pero si pasa) se cae a modo PIN -- nunca mostrar una
        // pantalla de bloqueo pidiendo un email que no existe.
        const metodoFinal = metodo === 'email' && email ? 'email' : 'pin';
        localStorage.setItem('zentia_ultimo_usuario', JSON.stringify({
          nombreUsuario,
          especie: <%- JSON.stringify(typeof barraSuperior !== 'undefined' && barraSuperior ? barraSuperior.especie : 'monstera') %>,
          // rama-fix-skin-planta: para que el lock-screen también muestre
          // el skin comprado, no solo la especie -- ver login.ejs, aplica
          // los colores client-side sobre el SVG ya renderizado.
          skin: <%- JSON.stringify(typeof barraSuperior !== 'undefined' && barraSuperior ? barraSuperior.skin : 'clasico') %>,
          metodo: metodoFinal,
          email: metodoFinal === 'email' ? email : null,
        }));
      } catch (err) {
        // Almacenamiento bloqueado (navegador privado, cuota llena, etc.)
        // -- /login simplemente no entra en modo pantalla de bloqueo, cae
        // al formulario completo de siempre. Nunca debe romper la página.
      }
    })();
  </script>
  <script>
    // rama-tema-jungla: toggle claro/oscuro. El ícono refleja el tema
    // ACTUAL (sol si se está mostrando claro, luna si oscuro). Guarda la
    // preferencia en la cuenta (no localStorage — ver COORDINACION.md).
    // rama-nav-mobile: ahora puede haber MÁS DE UN botón de toggle en la
    // página a la vez (el de la barra de escritorio y el del menú "más" de
    // mobile — nunca los dos visibles al mismo tiempo, pero los dos existen
    // en el DOM), así que se usa `data-toggle-tema` + querySelectorAll en
    // vez de un solo id: cualquiera de los dos que se toque actualiza el
    // tema y ambos íconos quedan sincronizados.
    (function () {
      const botones = document.querySelectorAll('[data-toggle-tema]');
      if (!botones.length) return;
      const RUTA_SOL = '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>';
      const RUTA_LUNA = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>';

      function temaActual() {
        const marcado = document.documentElement.getAttribute('data-theme');
        if (marcado === 'dark' || marcado === 'light') return marcado;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      function pintarIcono() {
        const ruta = temaActual() === 'dark' ? RUTA_LUNA : RUTA_SOL;
        botones.forEach((boton) => {
          const svg = boton.querySelector('svg');
          if (svg) svg.innerHTML = ruta;
        });
      }

      pintarIcono();

      botones.forEach((boton) => {
        boton.addEventListener('click', () => {
          const nuevo = temaActual() === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', nuevo);
          pintarIcono();
          fetch('/preferencia-tema', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tema: nuevo === 'dark' ? 'oscuro' : 'claro' }),
          }).catch(() => {});
        });
      });
    })();
  </script>
  <script>
    // rama-loading-states: feedback visual genérico de "esto ya se está
    // procesando" para cualquier submit de formulario -- antes ningún
    // botón cambiaba mientras esperaba la respuesta del servidor, así que
    // en una conexión lenta parecía que no había pasado nada y era fácil
    // reintentar el click y duplicar la acción.
    //
    // `window.mostrarCargaBoton(boton)` queda expuesto para que las pocas
    // páginas con su propio JS de submit (fetch en vez de navegación real,
    // o un delay a propósito como en captura.ejs) lo llamen ELLAS MISMAS
    // en el momento justo -- esas mismas páginas marcan su `<form>` con
    // `data-carga-manual` para que el listener genérico de acá abajo no
    // les pise el estado (ver captura.ejs e index.ejs).
    //
    // Para el resto (la gran mayoría, forms sin ningún JS propio, submit
    // nativo de toda la vida): un solo listener de 'submit' en `document`
    // alcanza. El navegador ya garantiza que el evento 'submit' no se
    // dispara si el form tiene campos `required` sin completar -- no hace
    // falta repetir esa validación acá.
    (function () {
      function mostrarCarga(boton) {
        if (!boton || boton.disabled) return;
        boton.disabled = true;
        boton.classList.add('cargando');
      }
      window.mostrarCargaBoton = mostrarCarga;

      document.addEventListener('submit', (e) => {
        const form = e.target;
        if (!(form instanceof HTMLFormElement) || form.dataset.cargaManual !== undefined) return;
        const boton = (e.submitter && e.submitter.type === 'submit')
          ? e.submitter
          : form.querySelector('button[type="submit"]:not([disabled])');
        mostrarCarga(boton);
      });
    })();
  </script>
  <script>
    // rama-inicio-planta: reemplaza al IIFE de 2 paneles de
    // rama-nav-rediseno (`.nav-expandido` + `.nav-drawer`) -- ahora es un
    // solo menú de pantalla completa (`.menu-pantalla`), así que no hace
    // falta coordinar "abrir uno cierra el otro" ni un overlay aparte
    // (el menú YA cubre toda la pantalla, no hay "afuera" que oscurecer
    // ni donde hacer click para cerrar -- se cierra con el botón X o
    // Escape). Con guardia por si algún día una vista no incluye el
    // partial de nav.
    (function () {
      const btnAbrir = document.getElementById('btn-menu-usuario');
      const btnCerrar = document.getElementById('btn-menu-cerrar');
      const panel = document.getElementById('menu-pantalla');
      if (!btnAbrir || !btnCerrar || !panel) return;

      function abrir() {
        panel.hidden = false;
        btnAbrir.setAttribute('aria-expanded', 'true');
      }

      function cerrar() {
        panel.hidden = true;
        btnAbrir.setAttribute('aria-expanded', 'false');
      }

      btnAbrir.addEventListener('click', abrir);
      btnCerrar.addEventListener('click', cerrar);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !panel.hidden) cerrar();
      });
    })();
  </script>
  <script>
    // rama-interfaz (Fase 4 de v0.2): anima la mini planta de la barra
    // superior al completar algo o al subir la racha.
    // - "Completar algo" en rutas de navegación real (POST /captura, POST
    //   /pendientes/:id/completar cuando NO hay JS interceptando el form --
    //   ver más abajo): agregan ?logro=1 a su redirect -- se lee acá, se
    //   anima, y se limpia de la URL con replaceState (para que un refresh
    //   no vuelva a animar).
    // - "Completar algo" en rutas que SÍ interceptan el form con fetch()
    //   (`.completar-form` en index.ejs -- confirmado leyendo su JS: usa
    //   fetch + actualiza el DOM a mano, nunca navega, así que el
    //   ?logro=1 del redirect del servidor nunca llega a aplicarse en el
    //   navegador): esas vistas llaman a `window.animarLogroBarraSuperior()`
    //   directamente tras el fetch exitoso. Se expone acá, en vez de
    //   duplicar la lógica de animación en cada vista.
    // - "Subir la racha": comparación puramente client-side contra
    //   localStorage (el número ya viene renderizado por el servidor en
    //   data-racha, no hace falta otra consulta a la DB) -- si es mayor que
    //   la última vista, anima y actualiza el valor guardado. Se guarda por
    //   usuario (usuarioId en la clave) porque el mismo navegador puede
    //   tener sesiones de distintas cuentas de prueba.
    (function () {
      const barra = document.getElementById('barra-superior');
      const planta = document.getElementById('barra-superior-planta');
      if (!barra || !planta) {
        window.animarLogroBarraSuperior = function () {};
        return;
      }

      function animarPlanta() {
        planta.classList.remove('animar');
        // Forzar reflow para poder re-disparar la animación si ya estaba activa.
        void planta.offsetWidth;
        planta.classList.add('animar');
      }

      function animarDato(clase) {
        const el = barra.querySelector('.' + clase);
        if (!el) return;
        el.classList.remove('animar');
        void el.offsetWidth;
        el.classList.add('animar');
      }

      window.animarLogroBarraSuperior = animarPlanta;

      // rama-racha-viva: actualiza los números de racha/semillas a mano --
      // hasta ahora quedaban desactualizados en vistas que interceptan su
      // form con fetch() y nunca navegan (ej. `.completar-form` de
      // index.ejs), porque esos `<span>` solo se renderizan una vez por
      // request real. Recibe el mismo objeto `barra` que ya devuelve
      // `barraSuperiorDeUsuario()` en el servidor ({ racha, semillas, ... }).
      // Anima el dato que cambió (mismo criterio que la racha vía
      // localStorage de más abajo) para que se sienta consistente con el
      // resto de la barra.
      window.actualizarBarraSuperior = function (datosBarra) {
        if (!datosBarra) return;
        const spanRacha = barra.querySelector('.barra-superior-racha span');
        const spanSemillas = barra.querySelector('.barra-superior-semillas span');
        if (spanRacha && Number(datosBarra.racha) !== Number(spanRacha.textContent)) {
          spanRacha.textContent = datosBarra.racha;
          animarDato('barra-superior-racha');
        }
        if (spanSemillas && Number(datosBarra.semillas) !== Number(spanSemillas.textContent)) {
          spanSemillas.textContent = datosBarra.semillas;
          animarDato('barra-superior-semillas');
        }
        barra.dataset.racha = datosBarra.racha;
      };

      const params = new URLSearchParams(window.location.search);
      if (params.get('logro') === '1') {
        animarPlanta();
        params.delete('logro');
        const query = params.toString();
        window.history.replaceState({}, '', window.location.pathname + (query ? '?' + query : ''));
      }

      const rachaActual = Number(barra.dataset.racha) || 0;
      const clave = 'racha_previa_' + (barra.dataset.usuario || 'anon');
      const rachaPrevia = Number(localStorage.getItem(clave)) || 0;
      if (rachaActual > rachaPrevia) {
        animarPlanta();
        animarDato('barra-superior-racha');
      }
      localStorage.setItem(clave, String(rachaActual));
    })();
  </script>
  <script>
    // rama-chat-visible: GET /notificaciones ya existía (construido de
    // antemano, nunca conectado a ninguna vista) -- solo cuenta mensajes
    // 1-a-1 sin leer (noLeidos), no el chat general (noLeidosGeneral,
    // decisión de rama-chat-general de no sumarlos, ver COORDINACION.md).
    // Un solo fetch al cargar cualquier página logueada -- no hace falta
    // polling en vivo, el contador se actualiza solo con la próxima
    // navegación (mismo criterio de "simple primero" del resto de badges
    // de esta app, ej. logrosNuevos).
    (function () {
      const boton = document.getElementById('btn-chat-amigos');
      const badge = document.getElementById('badge-chat-amigos');
      if (!boton || !badge) return;
      fetch('/notificaciones')
        .then((r) => (r.ok ? r.json() : null))
        .then((datos) => {
          if (!datos || !datos.noLeidos) return;
          badge.textContent = datos.noLeidos > 9 ? '9+' : String(datos.noLeidos);
          badge.hidden = false;
        })
        .catch(() => {});
    })();
  </script>
