  <script src="/sonidos.js"></script>
  <script>
    // rama-tema-jungla: toggle claro/oscuro. El ícono refleja el tema
    // ACTUAL (sol si se está mostrando claro, luna si oscuro). Guarda la
    // preferencia en la cuenta (no localStorage — ver COORDINACION.md).
    // rama-nav-mobile: ahora puede haber MÁS DE UN botón de toggle en la
    // página a la vez (el de la barra de escritorio y el del menú "más" de
    // mobile — nunca los dos visibles al mismo tiempo, pero los dos existen
    // en el DOM), así que se usa `data-toggle-tema` + querySelectorAll en
    // vez de un solo id: cualquiera de los dos que se toque actualiza el
    // tema y ambos íconos quedan sincronizados.
    (function () {
      const botones = document.querySelectorAll('[data-toggle-tema]');
      if (!botones.length) return;
      const RUTA_SOL = '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>';
      const RUTA_LUNA = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>';

      function temaActual() {
        const marcado = document.documentElement.getAttribute('data-theme');
        if (marcado === 'dark' || marcado === 'light') return marcado;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      function pintarIcono() {
        const ruta = temaActual() === 'dark' ? RUTA_LUNA : RUTA_SOL;
        botones.forEach((boton) => {
          const svg = boton.querySelector('svg');
          if (svg) svg.innerHTML = ruta;
        });
      }

      pintarIcono();

      botones.forEach((boton) => {
        boton.addEventListener('click', () => {
          const nuevo = temaActual() === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', nuevo);
          pintarIcono();
          fetch('/preferencia-tema', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tema: nuevo === 'dark' ? 'oscuro' : 'claro' }),
          }).catch(() => {});
        });
      });
    })();
  </script>
  <script>
    // rama-nav-rediseno: reemplaza al IIFE de "menú Más" de rama-nav-mobile
    // (mismo mecanismo -- botón + panel + overlay que oscurece, cierra con
    // click afuera o Escape) generalizado para los 2 paneles nuevos de
    // partials/nav.ejs: `.nav-expandido` (secciones de uso ocasional) y
    // `.nav-drawer` (cuenta/config). Abrir uno cierra el otro si estaba
    // abierto -- no tiene sentido tener los dos a la vez. Con guardia por
    // si algún día una vista no incluye el partial de nav.
    (function () {
      function armarPanel(idBoton, idPanel, idOverlay) {
        const btn = document.getElementById(idBoton);
        const panel = document.getElementById(idPanel);
        const overlay = document.getElementById(idOverlay);
        if (!btn || !panel || !overlay) return null;

        function cerrar() {
          panel.hidden = true;
          overlay.hidden = true;
          btn.setAttribute('aria-expanded', 'false');
        }

        function abrir() {
          panel.hidden = false;
          overlay.hidden = false;
          btn.setAttribute('aria-expanded', 'true');
        }

        btn.addEventListener('click', () => {
          if (panel.hidden) abrir(); else cerrar();
        });
        overlay.addEventListener('click', cerrar);

        return { abrir, cerrar, estaAbierto: () => !panel.hidden };
      }

      const expandido = armarPanel('btn-nav-expandir', 'nav-expandido', 'nav-expandido-overlay');
      const drawer = armarPanel('btn-nav-drawer', 'nav-drawer', 'nav-drawer-overlay');

      if (expandido && drawer) {
        document.getElementById('btn-nav-expandir').addEventListener('click', () => {
          if (drawer.estaAbierto()) drawer.cerrar();
        });
        document.getElementById('btn-nav-drawer').addEventListener('click', () => {
          if (expandido.estaAbierto()) expandido.cerrar();
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if (expandido && expandido.estaAbierto()) expandido.cerrar();
        if (drawer && drawer.estaAbierto()) drawer.cerrar();
      });
    })();
  </script>
  <script>
    // rama-nav-rediseno: "nav adaptativa" limitada a la zona secundaria
    // (`.nav-expandido`) -- los 5 accesos primarios de `.nav-top` NUNCA se
    // reordenan (ver la nota de UX research en COORDINACION.md: adaptar la
    // barra primaria completa rompe la memoria muscular de quien ya
    // vuelve seguido). Cuenta clics reales por href en localStorage
    // (mismo criterio "la preferencia vive en el navegador, no en la
    // cuenta" que ya usan `sonidosActivos` y el tutorial) y, en cada
    // carga de página, reordena esos mismos nodos de mayor a menor uso --
    // sin datos (usuario nuevo) o empatados, se respeta el orden por
    // defecto que ya trae el HTML.
    (function () {
      const CLAVE = 'zentia_nav_uso';
      const contenedor = document.getElementById('nav-expandido');
      if (!contenedor) return;
      const items = Array.from(contenedor.querySelectorAll('[data-nav-uso]'));
      if (!items.length) return;

      let usos = {};
      try {
        usos = JSON.parse(localStorage.getItem(CLAVE)) || {};
      } catch (e) {
        usos = {};
      }

      items.forEach((item, indice) => {
        item.dataset.navOrdenDefault = indice;
      });

      const ordenados = items.slice().sort((a, b) => {
        const usoA = usos[a.getAttribute('href')] || 0;
        const usoB = usos[b.getAttribute('href')] || 0;
        if (usoA !== usoB) return usoB - usoA;
        return Number(a.dataset.navOrdenDefault) - Number(b.dataset.navOrdenDefault);
      });
      ordenados.forEach((item) => contenedor.appendChild(item));

      items.forEach((item) => {
        item.addEventListener('click', () => {
          const href = item.getAttribute('href');
          usos[href] = (usos[href] || 0) + 1;
          localStorage.setItem(CLAVE, JSON.stringify(usos));
        });
      });
    })();
  </script>
  <script>
    // rama-interfaz (Fase 4 de v0.2): anima la mini planta de la barra
    // superior al completar algo o al subir la racha.
    // - "Completar algo" en rutas de navegación real (POST /captura, POST
    //   /pendientes/:id/completar cuando NO hay JS interceptando el form --
    //   ver más abajo): agregan ?logro=1 a su redirect -- se lee acá, se
    //   anima, y se limpia de la URL con replaceState (para que un refresh
    //   no vuelva a animar).
    // - "Completar algo" en rutas que SÍ interceptan el form con fetch()
    //   (`.completar-form` en index.ejs -- confirmado leyendo su JS: usa
    //   fetch + actualiza el DOM a mano, nunca navega, así que el
    //   ?logro=1 del redirect del servidor nunca llega a aplicarse en el
    //   navegador): esas vistas llaman a `window.animarLogroBarraSuperior()`
    //   directamente tras el fetch exitoso. Se expone acá, en vez de
    //   duplicar la lógica de animación en cada vista.
    // - "Subir la racha": comparación puramente client-side contra
    //   localStorage (el número ya viene renderizado por el servidor en
    //   data-racha, no hace falta otra consulta a la DB) -- si es mayor que
    //   la última vista, anima y actualiza el valor guardado. Se guarda por
    //   usuario (usuarioId en la clave) porque el mismo navegador puede
    //   tener sesiones de distintas cuentas de prueba.
    (function () {
      const barra = document.getElementById('barra-superior');
      const planta = document.getElementById('barra-superior-planta');
      if (!barra || !planta) {
        window.animarLogroBarraSuperior = function () {};
        return;
      }

      function animarPlanta() {
        planta.classList.remove('animar');
        // Forzar reflow para poder re-disparar la animación si ya estaba activa.
        void planta.offsetWidth;
        planta.classList.add('animar');
      }

      function animarDato(clase) {
        const el = barra.querySelector('.' + clase);
        if (!el) return;
        el.classList.remove('animar');
        void el.offsetWidth;
        el.classList.add('animar');
      }

      window.animarLogroBarraSuperior = animarPlanta;

      const params = new URLSearchParams(window.location.search);
      if (params.get('logro') === '1') {
        animarPlanta();
        params.delete('logro');
        const query = params.toString();
        window.history.replaceState({}, '', window.location.pathname + (query ? '?' + query : ''));
      }

      const rachaActual = Number(barra.dataset.racha) || 0;
      const clave = 'racha_previa_' + (barra.dataset.usuario || 'anon');
      const rachaPrevia = Number(localStorage.getItem(clave)) || 0;
      if (rachaActual > rachaPrevia) {
        animarPlanta();
        animarDato('barra-superior-racha');
      }
      localStorage.setItem(clave, String(rachaActual));
    })();
  </script>
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>
  <script>
    // rama-tutorial-multicapitulo: única variable que el motor genérico
    // (public/tutorial.js) necesita del servidor -- qué capítulos ya están
    // completados (para no re-disparar el básico, y para que /tutorial no
    // dependa de otro roundtrip). El resto (pasos, textos, selectores) vive
    // enteramente en el JS del cliente.
    window.__tutorialCapitulosCompletados = <%- JSON.stringify(typeof tutorialCapitulosCompletados !== 'undefined' ? tutorialCapitulosCompletados : []) %>;
  </script>
  <script src="/tutorial.js" defer></script>
