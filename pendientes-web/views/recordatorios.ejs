<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { titulo: 'Recordatorios' }) %>
</head>
<body>
  <main>
<%- include('partials/nav') %>
    <h1>⏰ Recordatorios</h1>

    <% if (typeof googleConfigurado !== 'undefined' && googleConfigurado) { %>
      <p class="count">
        <% if (googleConectado) { %>
          📅 Google Calendar conectado.
          <form method="POST" action="/calendario/desconectar" style="display:inline">
            <button type="submit" class="secundario">Desconectar</button>
          </form>
        <% } else { %>
          <a href="/calendario/conectar"><button type="button" class="secundario">📅 Conectar Google Calendar</button></a>
        <% } %>
      </p>
    <% } %>

<%- include('partials/filtro-rango', { rango }) %>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } else if (recordatorios.length === 0) { %>
      <p class="empty">No hay recordatorios todavía.</p>
    <% } else { %>
      <p class="count"><%= recordatorios.length %> recordatorio(s)</p>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Texto</th>
            <th>Cuándo</th>
            <th>Avisado</th>
            <% if (typeof googleConectado !== 'undefined' && googleConectado) { %>
              <th></th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% recordatorios.forEach((r, idx) => { %>
            <tr>
              <td><%= idx + 1 %></td>
              <td><%= r.texto %></td>
              <td><%= new Date(r.cuando).toLocaleString('es-PE', { timeZone: 'America/Lima' }) %></td>
              <td><%= r.avisado ? 'Sí' : 'No' %></td>
              <% if (typeof googleConectado !== 'undefined' && googleConectado) { %>
                <td>
                  <form method="POST" action="/recordatorios/<%= r.id %>/crear-evento-calendar" style="display:inline">
                    <button type="submit" class="secundario">📅 Crear evento</button>
                  </form>
                </td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>

<%- include('partials/scripts') %>
</body>
</html>
